# Shared password for the whole site (HTTP Basic auth; any username).
# Strongly recommended for anything reachable from the internet.
APP_PASSWORD=change-me

# Optional: a server-side Anthropic key used when the browser doesn't supply one.
# If set, APP_PASSWORD is required (the server refuses to start otherwise).
# ANTHROPIC_API_KEY=sk-ant-...

# Where workspace git repos live (mount a persistent disk here).
DATA_DIR=/data
PORT=8080
MAX_VARIANTS=8
